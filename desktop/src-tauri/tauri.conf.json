{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "NoFakeIP",
  "version": "0.1.0",
  "identifier": "com.nofakeip.desktop",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "NoFakeIP · DNS 诊断与测速",
        "width": 1120,
        "height": 760,
        "minWidth": 880,
        "minHeight": 560,
        "resizable": true,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "category": "Utility",
    "shortDescription": "DNS 诊断与测速工具",
    "longDescription": "NoFakeIP 帮你测出哪家 DNS 在国内快、哪家解析国外域名干净，并检查本地 Fake-IP 是否正常。不生成也不修改任何 Clash / OpenClash 配置。",
    "windows": {
      "nsis": {
        "languages": ["SimpChinese", "English"]
      }
    }
  }
}
