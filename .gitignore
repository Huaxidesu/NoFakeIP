/.build-logs/

# ---- 交付产物与本地数据 ----
# output/ 是打包好的安装包 / APK / 便携版，由构建产生，通过 Releases 分发。
output/
/data/*.db
*.db
*.db-journal
*.sqlite

# ---- 密钥与环境变量 ----
.env
.env.local
.env.*.local
*.jks
*.keystore
keystore.properties

# ---- 测试与覆盖率 ----
coverage/
*.lcov
.nyc_output/

# ---- 日志 ----
logs/
*.log
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*

# ---- 编辑器与操作系统 ----
.vscode/*
!.vscode/extensions.json
.idea/
.DS_Store
Thumbs.db
desktop.ini
*.suo
*.sw?
__pycache__/
*.py[cod]
.venv/
venv/

# ---- 杂项临时文件 ----
*.tmp
*.bak
*.orig
*.rej
